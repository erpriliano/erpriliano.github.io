---
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Erpriliano Abbas - Frontend Developer",
  description = "Personal portfolio website for Erpriliano Abbas, frontend developer based in Jakarta.",
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <link rel="canonical" href={canonical.toString()} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Go to homepage">EA</a>
        <nav aria-label="Primary navigation">
          <a href="/#experience">Experience</a>
          <a href="/#work">Work</a>
          <a href="/writing">Writing</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Erpriliano Abbas. Built with Astro.</p>
      </footer>
    </div>
  </body>
</html>

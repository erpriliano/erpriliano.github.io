---
import { profile } from "../data/profile"
import profileImage from "../images/icon_developer.png"
---

<section class="hero section">
  <div class="hero-copy">
    <p class="eyebrow">{profile.location}</p>
    <h1>{profile.name}</h1>
    <p class="lead">
      {profile.role} building scalable frontend systems, modern user experiences,
      and AI-assisted engineering workflows.
    </p>
    <p>{profile.intro}</p>
    <div class="actions">
      <a class="button primary" href="#expertise">Explore expertise</a>
      <a class="button secondary" href="#contact">Let's connect</a>
    </div>
  </div>
  <div class="hero-aside" aria-label="Profile summary">
    <img
      src={profileImage.src}
      width="168"
      height="168"
      alt="Erpriliano Abbas portrait"
    />
    <div>
      <span>Currently focused on</span>
      <strong
        >Frontend architecture, developer experience, and AI-assisted
        engineering.</strong
      >
    </div>
  </div>
</section>

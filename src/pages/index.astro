---
import BaseLayout from "../components/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import SectionHeading from "../components/SectionHeading.astro"
import { experience, profile, projects, skills } from "../data/profile"
---

<BaseLayout>
  <Hero />

  <section id="experience" class="section">
    <SectionHeading
      eyebrow="Experience"
      title="Building products, platforms, and engineering excellence"
      description={profile.summary}
    />
    <div class="timeline">
      {
        experience.map(item => (
          <article class="timeline-item">
            <time>{item.year}</time>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="expertise" class="section">
    <SectionHeading
      eyebrow="Expertise"
      title="Areas of Expertise"
      description="A snapshot of the technologies, systems, and engineering practices I work with most."
    />
    <div class="card-grid">
      {
        projects.map(project => (
          <article class="card">
            <div class="card-copy">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
            <div class="tag-list">
              {project.tags.map(tag => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="skills" class="section">
    <SectionHeading
      eyebrow="Skills"
      title="Technologies & Engineering Practices"
      description="The technologies, tools, and engineering approaches I use to build scalable and maintainable software."
    />
    <div class="skill-list">
      {
        skills.map(group => (
          <article>
            <h3>{group.title}</h3>
            <p>{group.items.join(" / ")}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="contact" class="section contact-band">
    <SectionHeading
      eyebrow="Contact"
      title="Let's work together"
      description="Open to opportunities involving frontend engineering, platform initiatives, architecture, and AI-assisted software development."
    />
    <div class="contact-links">
      {
        profile.socials.map(social => (
          <a href={social.href} target="_blank" rel="noreferrer">
            {social.label}
          </a>
        ))
      }
      <a href={profile.email}>Email</a>
    </div>
  </section>
</BaseLayout>
